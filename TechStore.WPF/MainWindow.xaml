<Window x:Class="TechStore.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TechStore.WPF.ViewModels"
        mc:Ignorable="d"
        Title="TechStore Application" Height="700" Width="1100"
        Background="{StaticResource AppBackground}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
    <Window.Resources>

        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <Grid>
                <Border Background="White" CornerRadius="20" Padding="50" 
                        VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="5" Opacity="0.1" Color="#FF6B8B"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="Welcome Back!" Style="{StaticResource HeaderStyle}" FontSize="28" Margin="0,0,0,30"/>

                        <TextBlock Text="Username" FontWeight="SemiBold" Foreground="{StaticResource TextGray}" Margin="5,0,0,5"/>
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                                 Margin="0,0,0,20" Height="45" VerticalContentAlignment="Center" FontSize="15"/>

                        <TextBlock Text="Password" FontWeight="SemiBold" Foreground="{StaticResource TextGray}" Margin="5,0,0,5"/>
                        <PasswordBox x:Name="PbPassword" Margin="0,0,0,30" Height="45" VerticalContentAlignment="Center" FontSize="15"/>

                        <Button Content="LOGIN" Command="{Binding LoginCommand}" 
                                CommandParameter="{Binding ElementName=PbPassword}"
                                IsDefault="True" Height="50" Margin="0,0,0,15" FontSize="16"/>

                        <Button Content="Create New Account" Command="{Binding RegisterCommand}" 
                                Background="Transparent" Foreground="{StaticResource AccentPink}" 
                                BorderThickness="0" FontSize="14" Cursor="Hand"/>

                        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,15,0,0" 
                                   HorizontalAlignment="Center" TextWrapping="Wrap" FontSize="14"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:RegisterViewModel}">
            <Grid>
                <Border Background="White" CornerRadius="20" Padding="40" 
                        VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="5" Opacity="0.1" Color="#FF6B8B"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="Create Account" Style="{StaticResource HeaderStyle}" FontSize="28" Margin="0,0,0,20"/>

                        <TextBlock Text="Username" FontWeight="SemiBold" Foreground="{StaticResource TextGray}" Margin="5,0,0,5"/>
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                                 Margin="0,0,0,15" Height="45" VerticalContentAlignment="Center" FontSize="15"/>

                        <TextBlock Text="Email Address" FontWeight="SemiBold" Foreground="{StaticResource TextGray}" Margin="5,0,0,5"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                                 Margin="0,0,0,15" Height="45" VerticalContentAlignment="Center" FontSize="15"/>

                        <TextBlock Text="Password" FontWeight="SemiBold" Foreground="{StaticResource TextGray}" Margin="5,0,0,5"/>
                        <PasswordBox x:Name="RegPassword" Margin="0,0,0,25" Height="45" VerticalContentAlignment="Center" FontSize="15"/>

                        <Button Content="SIGN UP" Command="{Binding RegisterCommand}" 
                                CommandParameter="{Binding ElementName=RegPassword}"
                                Height="50" Margin="0,0,0,10" IsDefault="True" FontSize="16"/>

                        <Button Content="Back to Login" Command="{Binding BackToLoginCommand}" 
                                Background="Transparent" Foreground="Gray" BorderThickness="0" FontSize="14"/>

                        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,10,0,0" 
                                   HorizontalAlignment="Center" TextWrapping="Wrap" FontSize="14"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <Grid Margin="25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="20" Padding="20" Margin="0,0,25,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.05"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="Search" FontWeight="Bold" Foreground="{StaticResource TextGray}" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="5" Height="35" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,0,0,20">
                            <TextBlock Text="Sort By" FontWeight="Bold" Foreground="{StaticResource TextGray}" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" Padding="5" BorderBrush="#FFE0E6" Height="35" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Categories" FontWeight="Bold" Foreground="{StaticResource TextGray}" Margin="0,0,0,10"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" 
                                     DisplayMemberPath="CategoryName" BorderThickness="0" Background="Transparent"/>
                        </Grid>

                        <StackPanel Grid.Row="3" Margin="0,15,0,0">
                            <Button Content="Reset Filters" Command="{Binding ResetFilterCommand}" Background="#E0E0E0" Foreground="Gray" Margin="0,0,0,10"/>
                            <Button Content="Add to Cart" Command="{Binding AddToCartCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Products" Style="{StaticResource HeaderStyle}" HorizontalAlignment="Left" FontSize="24" Margin="5,0,0,15"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" 
                             Background="Transparent" BorderThickness="0" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="15" Padding="15" Margin="8" Width="220" Height="150">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.05"/>
                                    </Border.Effect>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="16" 
                                                   Foreground="#333" TextWrapping="Wrap" TextAlignment="Center" Height="45"/>
                                        <TextBlock Text="{Binding Category.CategoryName}" Foreground="Gray" FontSize="12" 
                                                   HorizontalAlignment="Center" Margin="0,5"/>
                                        <TextBlock Text="{Binding Price, StringFormat={}{0:C}}" 
                                                   Foreground="{StaticResource AccentPink}" FontWeight="Bold" FontSize="18" 
                                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CartViewModel}">
            <Grid Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Shopping Cart" Style="{StaticResource HeaderStyle}" HorizontalAlignment="Left"/>

                <DataGrid Grid.Row="1" ItemsSource="{Binding CartItems}" SelectedItem="{Binding SelectedCartItem}" 
                          AutoGenerateColumns="False" Background="White" BorderThickness="0" Margin="0,0,0,20"
                          CanUserAddRows="False" GridLinesVisibility="Horizontal" RowHeight="45"
                          BorderBrush="#E0E0E0">
                    <DataGrid.Effect>
                        <DropShadowEffect BlurRadius="10" Opacity="0.05" Color="Black"/>
                    </DataGrid.Effect>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource PinkGradientBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Padding" Value="15,10"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat={}{0:C}}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Remove" Command="{Binding RemoveItemCommand}" Background="#FF8A80" Margin="0,0,15,0" Width="100"/>
                    <Button Content="Checkout" Command="{Binding CreateOrderCommand}" Background="#A5D6A7" Width="150"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.05"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="TechStore" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentPink}" 
                           VerticalAlignment="Center" Margin="10,0,30,0"/>

                <Button Content="Store" Command="{Binding NavigateHomeCommand}" Background="Transparent" Foreground="Gray" FontWeight="Normal"/>
                <Button Content="Cart" Command="{Binding NavigateCartCommand}" Background="Transparent" Foreground="Gray" FontWeight="Normal"/>

                <Button Content="Logout" Command="{Binding LogoutCommand}" HorizontalAlignment="Right" 
                        Background="Transparent" Foreground="#FF6B8B" FontWeight="Bold" Margin="30,5,5,5"/>
            </StackPanel>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}"/>
    </Grid>
</Window>