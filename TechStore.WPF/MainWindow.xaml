<Window x:Class="TechStore.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TechStore.WPF.ViewModels"
        Title="TechStore Application" Height="650" Width="1000"
        Background="{StaticResource BackgroundLight}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <Grid>
                <Border Background="White" CornerRadius="20" Padding="40" 
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.2" Color="Black"/>
                    </Border.Effect>

                    <StackPanel Width="300">
                        <TextBlock Text="TechStore Login" Style="{StaticResource HeaderStyle}"/>

                        <TextBlock Text="Username:" Foreground="Gray" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Username}" Margin="0,0,0,15"/>

                        <TextBlock Text="Password:" Foreground="Gray" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Password}" Margin="0,0,0,20"/>

                        <Button Content="Login" Command="{Binding LoginCommand}" Height="40" IsDefault="True"/>

                        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,15,0,0" 
                                   HorizontalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,20,0">
                    <StackPanel>
                        <TextBlock Text="Categories" FontSize="18" FontWeight="Bold" Foreground="{StaticResource DarkPink}" Margin="0,0,0,15"/>
                        <ListBox ItemsSource="{Binding Categories}" DisplayMemberPath="CategoryName" Height="300" BorderThickness="0"/>
                        <Button Content="Add to Cart" Command="{Binding AddToCartCommand}" Margin="0,20,0,0"/>
                    </StackPanel>
                </Border>

                <ListBox Grid.Column="1" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" 
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="10" Padding="10" Margin="5" Width="200" Height="120">
                                <StackPanel>
                                    <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="16" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Category.CategoryName}" Foreground="Gray" FontSize="12" Margin="0,5"/>
                                    <TextBlock Text="{Binding Price, StringFormat={}{0:C}}" Foreground="{StaticResource DarkPink}" FontWeight="Bold" FontSize="14" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CartViewModel}">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Your Shopping Cart" Style="{StaticResource HeaderStyle}" HorizontalAlignment="Left"/>

                <DataGrid Grid.Row="1" ItemsSource="{Binding CartItems}" SelectedItem="{Binding SelectedCartItem}" 
                          AutoGenerateColumns="False" Background="White" BorderThickness="0" Margin="0,0,0,20"
                          CanUserAddRows="False">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource PrimaryPink}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat={}{0:C}}" Width="100"/>
                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Remove Item" Command="{Binding RemoveItemCommand}" Background="#FF6666" Margin="0,0,10,0"/>
                    <Button Content="Checkout" Command="{Binding CreateOrderCommand}" Background="LightGreen"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" Direction="270"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="TechStore" FontSize="20" FontWeight="Bold" Foreground="{StaticResource DarkPink}" VerticalAlignment="Center" Margin="10,0,20,0"/>
                <Button Content="Store" Command="{Binding NavigateHomeCommand}"/>
                <Button Content="Cart" Command="{Binding NavigateCartCommand}"/>
                <Button Content="Logout" Command="{Binding LogoutCommand}" HorizontalAlignment="Right" Margin="20,5,5,5"/>
            </StackPanel>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}"/>
    </Grid>
</Window>