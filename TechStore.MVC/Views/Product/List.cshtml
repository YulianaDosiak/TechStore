@model IEnumerable<TechStore.DTO.Product>
<h2>Товари</h2>

<form method="get" class="mb-3">
    <input type="hidden" name="categoryId" value="@ViewBag.CategoryId" />
    <input name="searchString" class="form-control d-inline w-50" placeholder="Пошук..." />
    <button class="btn btn-secondary">Знайти</button>
    <a asp-action="List" asp-route-categoryId="@ViewBag.CategoryId" asp-route-sortOrder="@ViewBag.SortParam" class="btn btn-info">Сортувати за ціною</a>
</form>

<table class="table table-striped">
    <thead><tr><th>Назва</th><th>Ціна</th><th></th></tr></thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.ProductName</td>
                <td>@p.Price</td>
                <td><a asp-controller="Cart" asp-action="Add" asp-route-productId="@p.ProductID" class="btn btn-success btn-sm">В кошик</a></td>
            </tr>
        }
    </tbody>
</table>