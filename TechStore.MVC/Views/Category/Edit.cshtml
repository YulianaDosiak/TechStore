@model TechStore.DTO.Category
@{
    ViewData["Title"] = "Редагування";
}

<h2>Редагувати категорію</h2>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="CategoryID" />
    <div class="form-group mb-3">
        <label>Назва</label>
        <input asp-for="CategoryName" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-warning">Зберегти зміни</button>
    <a asp-action="Index" class="btn btn-secondary">Назад</a>
</form>