@model TechStore.MVC.Models.LoginViewModel
@{
    ViewData["Title"] = "Вхід";
}
<div class="row justify-content-center mt-5">
    <div class="col-md-4 card p-4 shadow">
        <h3 class="text-center text-primary">Вхід</h3>
        <form asp-action="Login" method="post">
            <div class="mb-3">
                <label>Логін</label>
                <input asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label>Пароль</label>
                <input asp-for="Password" type="password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <button class="btn btn-primary w-100">Увійти</button>
            @if (ViewBag.Error != null)
            {
                <div class="text-danger mt-2">@ViewBag.Error</div>

            }
            <div class="text-center mt-3">
                <a asp-action="ForgotPassword" class="text-decoration-none">Забули пароль?</a>
            </div>
        </form>
    </div>
</div>