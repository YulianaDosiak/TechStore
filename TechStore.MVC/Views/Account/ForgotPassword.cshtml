@{
    ViewData["Title"] = "Відновлення пароля";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow">
            <div class="card-body">
                <h3 class="text-center mb-4">Відновлення пароля</h3>

                @if (ViewBag.Message != null)
                {
                    <div class="alert alert-success">@ViewBag.Message</div>
                    <div class="text-center">
                        <a asp-action="Login" class="btn btn-link">Повернутися до входу</a>
                    </div>
                }
                else
                {
                    <form method="post">
                        <div class="mb-3">
                            <label class="form-label">Введіть ваш Email</label>
                            <input name="email" type="email" class="form-control" required />
                            <small class="text-muted">Ми надішлемо вам інструкції.</small>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">Надіслати</button>
                        </div>
                        @if (ViewBag.Error != null)
                        {
                            <div class="text-danger mt-2">@ViewBag.Error</div>
                        }
                    </form>
                }
            </div>
        </div>
    </div>
</div>