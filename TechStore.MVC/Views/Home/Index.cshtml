@{
    ViewData["Title"] = "Головна";
}

<div class="text-center mt-5">
    <h1 class="display-4">Вітаємо у TechStore</h1>
    <p>Проста система управління категоріями.</p>

    @if (!User.Identity.IsAuthenticated)
    {
        <p>Будь ласка, <a asp-controller="Account" asp-action="Login">увійдіть</a>, щоб почати роботу.</p>
    }
    else
    {
        <a class="btn btn-lg btn-primary" asp-controller="Category" asp-action="Index">Перейти до Категорій</a>
    }
</div>